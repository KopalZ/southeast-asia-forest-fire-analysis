# ==============================================================================
# Git Ignore Configuration - Southeast Asia Forest Fire Hotspot Analysis
# ==============================================================================

# Raw Large Datasets (~956.90 MiB) - Excluded from repository
DL_FIRE_SV-C2_837806/
DL_FIRE_SV-C2_837816/*.csv
data_asia_tenggara/*/*.csv

# Allow sample data and metadata
!data/sample/*.csv
!outputs/**/*.csv
!baseline/**/*.csv

# Private academic reports, screenshots, and logs (Public docs in docs/)
laporan/
docs/*.docx
docs/*.pdf
docs/_public_work*
Laporan_Tugas_Big_Data_Revisi*.pdf

# Local machine scripts and evidence logs containing usernames/paths
data_asia_tenggara/*.sh
data_asia_tenggara/*.txt
DL_FIRE_SV-C2_837816/*.sh
DL_FIRE_SV-C2_837816/*.txt

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
venv/
.env/
env/
.venv/

# Editor and OS specific files
~$*
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# Local logs and temporary files
*.tmp
*.temp
build_report.ps1
generate_report.py
